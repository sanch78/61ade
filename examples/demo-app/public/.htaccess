# Behind Apache (PHP-FPM, other OS user) the demos keep their own data copy under
# tmp/web, separate from the CLI/test copy (tmp/demo). Prepare it once with:
#   BLADE_DEMO_INSTANCE=web php8.4 examples/demo-app/setup-workspace.php
SetEnv BLADE_DEMO_INSTANCE web
# Every visitor works on an own copy of the pristine seed, purged after an idle hour; the developer key cookie
# selects the shared instance above (sandbox.php, docs/demos.md#visitor-sandboxes).
SetEnv BLADE_DEMO_SANDBOX 1

# Bearer API keys: Apache does not forward the Authorization header to PHP-FPM by default.
CGIPassAuth On
