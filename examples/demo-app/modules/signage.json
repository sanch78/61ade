{
    "section_descriptions": {
        "purpose": "Feature demo: digital signage (DMS) content register for the event calendar.",
        "covers": "media assets over files of the Signage mount (file field, derived type/resolution/length, usage count), default content per weekday or per date, lookup choices, a business rule hook."
    },
    "lookups": {
        "signage_assets": {
            "resource": "signage_assets",
            "table": "signage_assets",
            "key": "id",
            "label": "title"
        }
    },
    "resources": {
        "signage_assets": {
            "storage": {
                "table": "signage_assets",
                "key": "id",
                "computed": {
                    "usage": "(SELECT COUNT(*) FROM blade_calendar_events usage_event WHERE usage_event.space = 'signage' AND usage_event.deleted = 0 AND json_extract(usage_event.data, '$.asset_id') = CAST(blade_base.id AS TEXT)) + (SELECT COUNT(*) FROM signage_defaults usage_default WHERE usage_default.asset_id = CAST(blade_base.id AS TEXT))"
                }
            },
            "fields": [
                {
                    "name": "file_id",
                    "label": "Médiafájl",
                    "type": "file",
                    "required": true,
                    "max": 20,
                    "file": {
                        "resource": "files",
                        "mount": "signage",
                        "accept": [
                            "image",
                            "video"
                        ]
                    },
                    "column": {
                        "width": 96
                    }
                },
                {
                    "name": "title",
                    "label": "Megnevezés",
                    "required": true,
                    "max": 120,
                    "column": {
                        "editable": true,
                        "minWidth": 200
                    }
                },
                {
                    "name": "duration",
                    "label": "Lejátszási idő (mp)",
                    "type": "number",
                    "required": true,
                    "max": 5,
                    "default": "10",
                    "column": {
                        "editable": true,
                        "width": 150,
                        "align": "right"
                    }
                },
                {
                    "name": "usage",
                    "label": "Használat",
                    "type": "number",
                    "column": {
                        "width": 110,
                        "align": "right"
                    }
                }
            ],
            "operations": {
                "delete": true,
                "delete_policy": "delete"
            },
            "view": {
                "title": "Médiatár",
                "group": "Digitális kijelző",
                "icon": "dxi dxi-image-outline",
                "tiles": true,
                "row_height": 56,
                "search": [
                    "title"
                ],
                "columns": [
                    {
                        "id": "file_id",
                        "header": "Médiafájl"
                    },
                    {
                        "id": "title",
                        "header": "Megnevezés"
                    },
                    {
                        "id": "media_type",
                        "header": "Típus",
                        "media_of": "file_id",
                        "part": "type"
                    },
                    {
                        "id": "media_resolution",
                        "header": "Felbontás",
                        "media_of": "file_id",
                        "part": "resolution"
                    },
                    {
                        "id": "media_length",
                        "header": "Hossz",
                        "media_of": "file_id",
                        "part": "duration"
                    },
                    {
                        "id": "duration",
                        "header": "Lejátszási idő (mp)"
                    },
                    {
                        "id": "usage",
                        "header": "Használat"
                    }
                ],
                "actions": [
                    "get",
                    "create",
                    "update",
                    "delete"
                ]
            }
        },
        "signage_defaults": {
            "storage": {
                "table": "signage_defaults",
                "key": "id"
            },
            "hooks": {
                "after_save": "signage.default_check"
            },
            "fields": [
                {
                    "name": "weekday",
                    "label": "A hét napja",
                    "type": "select",
                    "options": {
                        "1": "Hétfő",
                        "2": "Kedd",
                        "3": "Szerda",
                        "4": "Csütörtök",
                        "5": "Péntek",
                        "6": "Szombat",
                        "7": "Vasárnap"
                    },
                    "column": {
                        "width": 150
                    }
                },
                {
                    "name": "date",
                    "label": "Dátum",
                    "max": 10,
                    "validation": {
                        "pattern": {
                            "expression": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                            "message": "Formátum: ÉÉÉÉ-HH-NN."
                        }
                    },
                    "column": {
                        "editable": true,
                        "width": 130
                    }
                },
                {
                    "name": "asset_id",
                    "label": "Alapértelmezett tartalom",
                    "type": "select",
                    "required": true,
                    "options_lookup": "signage_assets",
                    "column": {
                        "editable": true,
                        "minWidth": 220
                    }
                }
            ],
            "operations": {
                "delete": true
            },
            "view": {
                "title": "Alapértelmezett tartalom",
                "group": "Digitális kijelző",
                "icon": "dxi dxi-clock-outline",
                "columns": [
                    {
                        "id": "weekday",
                        "header": "A hét napja"
                    },
                    {
                        "id": "date",
                        "header": "Dátum"
                    },
                    {
                        "id": "asset_id",
                        "header": "Alapértelmezett tartalom"
                    }
                ],
                "actions": [
                    "get",
                    "create",
                    "update",
                    "delete"
                ]
            }
        }
    }
}
