{
    "section_descriptions": {
        "purpose": "Feature demo: a large read-only synthetic list and a dashboard over it.",
        "covers": "virtual scrolling over a large SQL result, server-side sorting and filtering with a bounded client window; the toolkit column presentation demo.reading-bar and the project view kind demo.readings-dashboard (ListView, Suite Chart and summary linked by selection and filter)."
    },
    "resources": {
        "demo_readings": {
            "storage": {
                "table": "demo_readings",
                "key": "id"
            },
            "operations": {
                "create": false,
                "update": false
            },
            "fields": [
                {
                    "name": "title",
                    "label": "Megnevezés",
                    "required": true,
                    "max": 120
                },
                {
                    "name": "reading",
                    "label": "Érték",
                    "max": 20,
                    "column": {
                        "presentation": "demo.reading-bar"
                    }
                }
            ],
            "view": {
                "title": "Mérések",
                "group": "Feature demó",
                "icon": "dxi dxi-table-check",
                "columns": [
                    {
                        "id": "title",
                        "header": "Megnevezés"
                    },
                    {
                        "id": "reading",
                        "header": "Érték"
                    }
                ],
                "actions": [
                    "get"
                ]
            }
        }
    },
    "views": {
        "demo.readings-dashboard": {
            "kind": "demo.readings-dashboard",
            "title": "Mérési irányítópult",
            "resource": "demo_readings",
            "actions": [
                "list"
            ],
            "options": {
                "list": "demo_readings",
                "value": "reading",
                "name": "title",
                "max": 100,
                "buckets": 10
            },
            "group": "Feature demó",
            "icon": "dxi dxi-chart-vertical"
        }
    }
}
