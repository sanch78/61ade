{
    "section_descriptions": {
        "purpose": "Feature demo: a declared double-click/Enter activation (view.activate).",
        "covers": "a parent list whose activation opens the record's child list (subview, also for an empty shelf, from table, cards and tiles), a zone list whose activation opens the shelves page filtered to the zone (page), and a child list whose activation runs a registered record action."
    },
