                    "max": 120
                },
                {
                    "name": "note",
                    "label": "Megjegyzés",
                    "max": 120
                }
            ],
            "view": {
                "title": "Katalógus",
                "group": "Feature demó",
                "icon": "dxi dxi-image-outline",
                "row_height": 56,
                "columns": [
                    {
                        "id": "image",
                        "header": "Kép"
                    },
                    {
                        "id": "title",
                        "header": "Megnevezés"
                    },
                    {
                        "id": "note",
                        "header": "Megjegyzés"
                    }
                ],
                "actions": [
                    "get"
                ],
                "guide": "Statikus képoszlop: a Kép mező egy fájlnevet tárol, a lista ebből mutat képet a táblázat cellájában, a kártyán, a csempén és az Adatok ablakban.\n\nHiányzó képfájlnál helyőrző látszik, érvénytelen fájlnévnél nincs kép. A katalógus csak olvasható."
            }
        }
