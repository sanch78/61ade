                "severity": "neutral",
                "confirm_label": "Folytatás",
                "cancel_label": "Mégse"
            }
        },
        {
            "resource": "demo_tasks",
            "name": "dialog_warning",
            "label": "Párbeszéd: Figyelmeztetés",
