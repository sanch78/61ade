{
    "section_descriptions": {
        "purpose": "Feature demo: one synthetic module that exercises the declarative workspace capabilities.",
        "covers": "panel form, filters, sorting, cards, inline grid editing (text, select, checkbox), related storage, pattern validation, multiple choice, delete, selection with bulk action, registered business action, business rule hook with a field error, a project field type (priority rating) and a client record command (copy as text)."
    },
    "resources": {
        "demo_tasks": {
            "hooks": {
                "after_save": "tasks.after_save"
            },
            "storage": {
                "table": "demo_tasks",
                "key": "id",
                "owner_column": "owner_id",
                "defaults": {
                    "status": "new",
                    "archived": 0,
                    "priority": 0
                },
                "related": [
                    {
                        "table": "demo_task_settings",
                        "key": "task_id",
                        "fields": {
                            "notify": "notifications"
                        },
                        "defaults": {
                            "notify": 1
                        }
                    }
                ]
            },
            "fields": [
                {
                    "name": "title",
                    "label": "Megnevezés",
                    "required": true,
                    "max": 120,
                    "column": {
                        "editable": true,
                        "minWidth": 200
                    }
                },
                {
                    "name": "status",
                    "label": "Állapot",
                    "type": "select",
                    "required": true,
                    "default": "new",
                    "bulk": true,
                    "options": {
                        "new": "Új",
                        "progress": "Folyamatban",
                        "done": "Kész"
                    },
                    "column": {
                        "editable": true,
                        "width": 140
                    }
                },
                {
                    "name": "priority",
                    "label": "Prioritás",
                    "type": "number",
                    "default": "0",
                    "editor": "demo.rating",
                    "validation": {
                        "pattern": {
                            "expression": "^[0-5]$",
                            "message": "0 és 5 közötti egész szám adható meg."
                        }
                    },
                    "column": {
                        "editable": true,
                        "width": 130
                    }
                },
                {
                    "name": "contact",
                    "label": "Kapcsolattartó telefon",
                    "max": 20,
                    "validation": {
                        "pattern": {
                            "expression": "^\\+36[0-9]{8,9}$",
                            "message": "Formátum: +36 és 8–9 számjegy."
                        }
                    },
                    "column": {
                        "editable": true,
                        "width": 170
                    }
                },
                {
                    "name": "labels",
                    "label": "Címkék",
                    "type": "multiselect",
                    "max": 200,
                    "options": {
                        "urgent": "Sürgős",
                        "customer": "Ügyfél",
                        "internal": "Belső",
                        "risk": "Kockázat"
                    },
                    "column": {
                        "width": 180
                    }
                },
                {
                    "name": "archived",
                    "label": "Archivált",
                    "type": "checkbox",
                    "options": {
                        "0": "Aktív",
                        "1": "Archivált"
                    },
                    "column": {
                        "editable": true,
                        "width": 110,
                        "align": "center"
                    }
                },
                {
                    "name": "notify",
                    "label": "Értesítés",
                    "type": "checkbox",
                    "default": "1",
                    "options": {
                        "0": "Ki",
                        "1": "Be"
                    },
                    "column": {
                        "editable": true,
                        "width": 110,
                        "align": "center"
                    }
                },
                {
                    "name": "description",
                    "label": "Részletes leírás",
                    "type": "textarea",
                    "max": 2000
                }
            ],
            "operations": {
                "delete": true
            },
            "view": {
                "title": "Feladatok",
                "group": "Feature demó",
                "icon": "dxi dxi-checkbox-marked",
                "selection": true,
                "columns": [
                    {
                        "id": "title",
                        "header": "Megnevezés"
                    },
                    {
                        "id": "status",
                        "header": "Állapot"
                    },
                    {
                        "id": "priority",
                        "header": "Prioritás"
                    },
                    {
                        "id": "contact",
                        "header": "Kapcsolattartó telefon"
                    },
                    {
                        "id": "labels",
                        "header": "Címkék"
                    },
                    {
                        "id": "archived",
                        "header": "Archivált"
                    },
                    {
                        "id": "notify",
                        "header": "Értesítés"
                    }
                ],
                "actions": [
                    "get",
                    "create",
                    "update",
                    "delete",
                    "complete",
                    "dialog_neutral",
                    "dialog_warning",
                    "dialog_danger"
                ],
                "commands": [
                    "demo.copy-text"
                ],
                "layout": {
                    "form_mode": "panel"
                },
                "guide": "Egyetlen modulban a deklaratív lista szinte minden képessége: szűrőpanel, rendezés a fejlécre kattintva, táblázat és kártya nézet, valamint az oldalsó panelben nyíló szerkesztőűrlap.\n\nPróbáld ki: a táblázatban közvetlenül szerkeszthető a Megnevezés, az Állapot, a Prioritás és a kapcsolók; a Kapcsolattartó telefon mintára ellenőriz; a Prioritás egy projekt saját mezőtípusa (csillagok). Jelölj meg több sort, és futtass rajtuk tömeges műveletet; a Lezárás regisztrált üzleti művelet, a Párbeszéd műveletek a megerősítő és nyugtázó ablakokat mutatják.\n\nÜzleti szabály: folyamatban lévő feladatnál nem kapcsolható ki az Értesítés, a szerver mezőhibával utasítja el. A Másolás szövegként egy kliensoldali rekordparancs."
            }
        }
    },
    "actions": [
        {
            "resource": "demo_tasks",
            "name": "complete",
            "label": "Lezárás",
            "handler": "tasks.complete",
            "target_resource": "demo_tasks",
            "write": true,
            "bulk": true,
            "icon": "dxi dxi-check",
            "channels": [
                "ui",
                "api"
            ]
        },
        {
            "resource": "demo_tasks",
            "name": "dialog_neutral",
            "label": "Párbeszéd: Információ (semleges)",
            "handler": "tasks.dialog_neutral",
            "target_resource": "demo_tasks",
            "write": false,
            "icon": "dxi dxi-information-outline",
            "channels": [
