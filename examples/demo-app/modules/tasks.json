                "severity": "warning",
                "confirm_label": "Folytatás",
                "cancel_label": "Mégse"
            }
        },
        {
            "resource": "demo_tasks",
            "name": "dialog_danger",
            "label": "Párbeszéd: Hiba / veszély",
            "handler": "tasks.dialog_danger",
            "target_resource": "demo_tasks",
